# Development verbs for the zarr-chunk-key-encoding package. Recipes run with
# this directory as the working directory regardless of where `just` is
# invoked.

# Keep this aligned with the repo-root pre-commit environment. The docs group
# pins its own Ruff version because mkdocstrings uses it for rendered signatures.
ruff_version := "0.16.0"

# List available recipes
default:
    @just --list

# The sibling zarr-metadata package is layered in as an editable overlay so
# the two packages can be developed in lockstep; the published package
# depends on the released zarr-metadata distribution.
#
# Unlike `test-parity`, this recipe is safe on a tag-less shallow checkout,
# though the two look alike. `uv sync` resolves this package's
# `zarr-metadata>=0.4.0` floor against the index first, and `--with-editable`
# then overlays the local build without re-resolving it -- so the overlay's
# hatch-vcs version, which needs `zarr_metadata-v*` tags to be meaningful,
# never has to satisfy the floor. `test-parity` resolved against the repo
# root instead, which did force the overlay through the floor, and that is
# why it stopped overlaying zarr-metadata at all.
# Run the test suite; extra args are passed to pytest
test *args:
    uv run --group test --with-editable ../zarr-metadata python -m pytest {{ args }}

# Run the zarr parity tests on Python 3.12 against the repo-root environment,
# which provides `zarr` (deliberately not a dependency of this package). The
# root project requires Python >=3.12 even though this package supports 3.11.
#
# Unlike `test`, this does not overlay the sibling zarr-metadata: resolving
# this package's `zarr-metadata>=0.4.0` floor against an editable sibling
# means hatch-vcs has to derive that sibling's version from `zarr_metadata-v*`
# tags, and a clone without them (a fork whose tags were never pushed, a
# shallow CI checkout) silently produces a pre-0.4.0 version and an
# unsatisfiable resolution. Taking zarr-metadata from the index instead makes
# this recipe independent of tag hygiene, and checks this package against the
# released zarr-metadata it actually declares. Lockstep development of the two
# packages is what `test` is for.
test-parity *args:
    UV_PYTHON=3.12 ZARR_PARITY_REQUIRED=1 uv run --project ../.. --group test --with-editable . python -m pytest tests/test_zarr_parity.py {{ args }}

# Lint with the same invocation CI uses
lint:
    uvx ruff@{{ ruff_version }} check .

# CI runs pyright on python 3.11, the oldest supported interpreter.
# Type-check the package sources
typecheck:
    uv run --python 3.11 --group test --with-editable ../zarr-metadata pyright src

# Run everything CI runs for this package
check: lint typecheck test test-parity docs-check

# Preview the changelog that the next release would generate
changelog-draft:
    uv run --group release towncrier build --draft --version Unreleased

# Build this package's documentation site, warnings as errors
docs-check:
    env DISABLE_MKDOCS_2_WARNING=true uv run --group docs --with-editable ../zarr-metadata mkdocs build --strict

# With no argument, uses port 8000 if free, otherwise an ephemeral free port;
# an explicitly requested port is used as-is so a conflict fails loudly.
# Serve this package's documentation site
docs-serve port="":
    #!/usr/bin/env bash
    set -euo pipefail
    port="{{ port }}"
    if [ -z "$port" ]; then
        port=$(uv run --group docs python -c '
    import socket
    s = socket.socket()
    try:
        s.bind(("127.0.0.1", 8000))
    except OSError:
        s.close()
        s = socket.socket()
        s.bind(("127.0.0.1", 0))
    print(s.getsockname()[1])
    s.close()
    ')
    fi
    exec env DISABLE_MKDOCS_2_WARNING=true uv run --group docs --with-editable ../zarr-metadata mkdocs serve -a "localhost:$port"
